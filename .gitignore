# Ignore KTX and glTF files (large binary assets)
gltf/

# Compiled Dynamic libraries
*.so
*.dylib

# Compiled Static libraries
*.a
*.lib

# Executables
*.exe
*.out

# Local assets, private documentation, and helper scripts are tracked separately.
/assets/*
!/assets/CREDITS.md
/doc/
/docs/
/scripts/

#Artifacts
artifacts/


