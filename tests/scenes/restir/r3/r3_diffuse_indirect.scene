# R3 bounded ReSTIR GI prototype fixture.
# Small diffuse-dominant scene for first-bounce indirect candidate reuse checks.
# No canonical assets or camera framing are modified.

camera target=0.0,1.0,-1.0 distance=6.2 yaw=1.570796 pitch=-0.13 vfov=34.0 defocusAngle=0.0 focusDist=6.2
background solid=0.0,0.0,0.0
renderer maxDepth=4 samplesPerFrame=1 tonemap=1 exposure=0.0 russianRoulette=0 enableSpecularNee=1 enableMnee=0

material name=matte_gray type=lambert albedo=0.72,0.72,0.72
material name=matte_red type=lambert albedo=0.90,0.18,0.12
material name=matte_blue type=lambert albedo=0.12,0.22,0.85
material name=emissive_key type=diffuse_light albedo=0.0,0.0,0.0 emit=4.0,4.0,4.0

mesh name=r3_floor type=plane material=matte_gray position=0.0,0.0,0.0 scale=5.0,1.0,5.0
mesh name=r3_receiver type=plane material=matte_gray position=0.0,1.05,-1.35 scale=2.2,1.0,2.2 rotate=90.0,0.0,0.0
mesh name=r3_left_bounce type=plane material=matte_red position=-1.7,1.0,-0.35 scale=2.0,1.0,2.0 rotate=0.0,0.0,90.0
mesh name=r3_right_bounce type=plane material=matte_blue position=1.7,1.0,-0.35 scale=2.0,1.0,2.0 rotate=0.0,0.0,-90.0
mesh name=r3_key_light type=plane material=emissive_key position=0.0,3.0,0.15 scale=1.2,1.0,1.2
